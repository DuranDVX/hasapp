ANTHROPIC_API_KEY=
# Pilot: sign-up needs this invite code. Leave empty for open sign-up.
HAS_SIGNUP_CODE=
# Production: Postgres URL (Railway sets it). Development uses SQLite in data/.
# DATABASE_URL=
# PUBLIC_URL=https://app.example.co.za
# HAS_SECRET_KEY=          # signs file links; else data/secret.key
# CRON_TOKEN=              # protects POST /api/cron/expiry (daily expiry emails)
# RESEND_API_KEY=          # email in production
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=
# AZURE_SPEECH_KEY=        # optional: spoken toolbox talks (en, af, zu)
# AZURE_SPEECH_REGION=southafricanorth
# HAS_APP_NAME=SiteSafe    # working name
# HAS_MODEL=claude-opus-5-5
# HAS_EFFORT=low
